generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Animal {
  id                 String   @id @default(uuid())
  qr_code            String   @unique @db.VarChar(255)
  species            String   @db.VarChar(100)
  name               String?  @db.VarChar(255)
  birth_date         DateTime?
  parent_father      String?  @db.VarChar(255)
  parent_mother      String?  @db.VarChar(255)
  medications        Json     @default("[]")
  pregnancies        Json     @default("[]")
  lactation_periods  Json     @default("[]")
  offspring          Json     @default("[]")
  weight_records     Json     @default("[]")
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("animals")
}
